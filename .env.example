# Public pages render without credentials. Authentication needs MongoDB.
# Use your exact HTTPS app origin in production, with no trailing path.
APP_URL=http://localhost:3000
# Production auth currently requires Vercel's trusted client-IP header.
# VERCEL is supplied by the platform; do not set it manually on another host.
# Local development retains per-email/token limits without a shared IP bucket.
# Use a development database, never production data locally.
MONGODB_URI=
# Password reset delivery only (signup/login do not need Resend).
RESEND_API_KEY=
# Example: Make My Marriage <accounts@your-verified-domain.com>
EMAIL_FROM=
# Future integrations (not used by authentication).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
GOOGLE_PLACES_API_KEY=
CRON_SECRET=
